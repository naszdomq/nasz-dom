rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Wpisy, profile i kopie zapasowe: dostęp TYLKO dla waszego wspólnego konta.
    match /{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.token.email == "dom@naszdom.pl";
    }
  }
}
